{
  "namespace": "cinnabar_storage",
  "container_items_item@common.container_item": {
    "$item_collection_name": "container_items"
  },
  "inventory_items_item@common.container_item": {
    "$item_collection_name": "inventory_items"
  },
  "hotbar_items_item@common.container_item": {
    "$item_collection_name": "hotbar_items"
  },
  "panel": {
    "type": "panel",
    "controls": [
      {
        "root_panel@common.root_panel": {
          "size": [
            176,
            "$panel_height"
          ],
          "controls": [
            {
              "background@common.common_panel": {}
            },
            {
              "title": {
                "type": "label",
                "text": "$container_title",
                "localize": false,
                "color": [
                  0.25,
                  0.25,
                  0.25
                ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [
                  8,
                  6
                ],
                "size": [
                  150,
                  10
                ],
                "layer": 2
              }
            },
            {
              "storage": {
                "type": "grid",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [
                  7,
                  17
                ],
                "size": [
                  162,
                  "$storage_height"
                ],
                "grid_dimensions": [
                  9,
                  "$storage_rows"
                ],
                "grid_item_template": "cinnabar_storage.container_items_item",
                "collection_name": "container_items",
                "layer": 2
              }
            },
            {
              "inventory_title": {
                "type": "label",
                "text": "$inventory_title",
                "localize": false,
                "color": [
                  0.25,
                  0.25,
                  0.25
                ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [
                  8,
                  "$inventory_label_y"
                ],
                "size": [
                  150,
                  10
                ],
                "layer": 2
              }
            },
            {
              "inventory": {
                "type": "grid",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [
                  7,
                  "$inventory_y"
                ],
                "size": [
                  162,
                  54
                ],
                "grid_dimensions": [
                  9,
                  3
                ],
                "grid_item_template": "cinnabar_storage.inventory_items_item",
                "collection_name": "inventory_items",
                "layer": 2
              }
            },
            {
              "hotbar": {
                "type": "grid",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [
                  7,
                  "$hotbar_y"
                ],
                "size": [
                  162,
                  18
                ],
                "grid_dimensions": [
                  9,
                  1
                ],
                "grid_item_template": "cinnabar_storage.hotbar_items_item",
                "collection_name": "hotbar_items",
                "layer": 2
              }
            }
          ]
        }
      }
    ]
  },
  "screen@common.inventory_screen_common": {
    "$screen_content": "cinnabar_storage.panel",
    "$screen_bg_content": "common.screen_background",
    "$screen_background_alpha": 0.4
  }
}
